{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "workspace.library": [
    ".tools/wow-api/Annotations/Core",
    "tools/wow/annotations"
  ],
  "workspace.ignoreDir": [
    ".tools",
    ".build",
    ".release",
    "spec",
    "tools"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.globals": [],
  "type.weakUnionCheck": true
}
